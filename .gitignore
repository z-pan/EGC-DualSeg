__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env

# Packaged data and raw-derived artefacts carry per-patient clinical attributes.
# They live locally and on Drive, never in the repository.
data/packaged/
*.npz
*.npy
manifest.csv

# Model weights: archived to Drive, not versioned here.
checkpoints/
*.pt
*.pth
*.ckpt

# Prediction CSVs ARE committed (results/*.csv) — they are what makes the
# figures reproducible without a GPU. Only logs and scratch output are ignored.
# Note the trailing /* rather than /: git never descends into an excluded
# DIRECTORY, so a negation below it can never re-include anything. Excluding the
# contents instead is what makes the exception work.
results/logs/*
results/scratch/
# Exception: the MMD calibration logs. Their train_mmd column is the only record
# of how much the alignment term actually contributed, and the weight chosen for
# the published sweep was picked from it. That makes them a result, not scratch —
# without them the calibration table cannot be reproduced from the repository.
!results/logs/mmdcal_*.csv
wandb/
runs/
checkpoints_local/

# Anything that maps a packaged image back to the archive. These carry the
# per-patient directory structure of the source data (case folders, per-case
# file names) and the local absolute paths to it. The index files are a patient-
# level index of the cohort's imaging; the script that builds them hardcodes the
# archive layout. None of it is needed to reproduce a figure from the committed
# CSVs, and all of it is a privacy liability in a public repository.
outputs/raw_image_index.csv
outputs/figure_raw_images.txt
scripts/raw_image_path.py

# Zipped copies of CSVs that are already committed file-by-file under results/.
# They were transfer archives from Colab; keeping them would double the repo for
# no reproducibility gain.
*_csvs.zip

# Rendered figures are build products, not sources. Some of them (Fig. 3d, the
# exemplar panels) contain endoscopic frames, so they must not be committed to a
# public repository even as output. Run the scripts to regenerate.
figures/*.png
figures/*.pdf
figures/*.tiff
figures/*.svg
